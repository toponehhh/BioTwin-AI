@page "/resume/upload"
@inject NavigationManager Navigation

<PageTitle>Create Resume</PageTitle>

<ProtectedArea Title="Resume creation requires sign in" Description="Sign in to create or import a resume.">
    <p class="status-line" role="status">Opening the resume creation wizard...</p>
</ProtectedArea>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.NavigateTo("/resume/create", replace: true);
        }
    }
}
