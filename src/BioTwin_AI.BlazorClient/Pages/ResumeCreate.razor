@page "/resume/create"
@implements IDisposable
@using BioTwin_AI.BlazorClient.Components.ResumeWizard
@inject IResumeApiClient ResumeApiClient
@inject NavigationManager Navigation
@inject SessionState SessionState
@inject IJSRuntime JS

<PageTitle>Create Resume</PageTitle>

<ProtectedArea Title="Resume creation requires sign in" Description="Sign in to create or import a resume.">
    <BlockingProgressOverlay Visible="@ShowImportDialog"
                             Job="@importJob"
                             OnCancel="CancelImportAsync"
                             OnRetry="RetryImportAsync"
                             OnChooseAnother="ChooseAnotherFile" />
    <NavigationLock ConfirmExternalNavigation="@((state.IsDirty || isBusy) && !isSaving)"
                    OnBeforeInternalNavigation="ConfirmInternalNavigation" />

    <section class="resume-wizard-page">
        <header class="workspace-header wizard-page-header">
            <div>
                <p class="eyebrow">Resume Builder</p>
                <h1>Create your resume</h1>
                <p>Build a focused, language-specific resume without saving unfinished drafts.</p>
            </div>
            <a class="text-button" href="/resume/workspace">Advanced workspace</a>
        </header>

        <div class="resume-wizard-panel">
            <ResumeWizardStepper State="state" StepSelected="NavigateToStep" />

            @if (errors.Count > 0)
            {
                <div class="wizard-message error" role="alert">
                    @foreach (var error in errors)
                    {
                        <p>@error</p>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <p class="wizard-message" role="status">@statusMessage</p>
            }

            <div class="wizard-step-body" aria-busy="@isBusy">
                @switch (state.CurrentStep)
                {
                    case ResumeWizardStep.Start:
                        <ResumeWizardStartStep State="state"
                                               FileSelected="SelectFileAsync"
                                               SelectedFileName="@pendingUpload?.FileName"
                                               SelectedFileSize="@(pendingUpload?.Size ?? 0)" />
                        break;
                    case ResumeWizardStep.Profile:
                        <ResumeWizardProfileStep State="state" />
                        break;
                    case ResumeWizardStep.Summary:
                        <ResumeWizardSummaryStep State="state" />
                        break;
                    case ResumeWizardStep.Experience:
                        <ResumeWizardExperienceStep State="state" />
                        break;
                    case ResumeWizardStep.Education:
                        <ResumeWizardEducationStep State="state" />
                        break;
                    case ResumeWizardStep.SkillsAndProjects:
                        <ResumeWizardSkillsProjectsStep State="state" />
                        break;
                    case ResumeWizardStep.Review:
                        <ResumeWizardReviewStep State="state" EditStepRequested="NavigateToStep" />
                        break;
                }
            </div>

            <footer class="wizard-actions">
                <button type="button" class="text-button" @onclick="CancelAsync" disabled="@isSaving">Cancel</button>
                <div class="wizard-action-group">
                    <button type="button"
                            class="command-button secondary"
                            @onclick="MoveBack"
                            disabled="@(state.CurrentStep == ResumeWizardStep.Start || isBusy || isSaving)">
                        Back
                    </button>
                    @if (state.CurrentStep == ResumeWizardStep.Review)
                    {
                        <button type="button" class="command-button" @onclick="SaveAsync" disabled="@(isBusy || isSaving)">
                            @(isSaving ? "Saving..." : "Save resume")
                        </button>
                    }
                    else
                    {
                        <button type="button" class="command-button" @onclick="ContinueAsync" disabled="@(isBusy || isSaving)">Continue</button>
                    }
                </div>
            </footer>
        </div>
    </section>
</ProtectedArea>

@code {
    private const long MaxUploadBytes = 10 * 1024 * 1024;
    private readonly ResumeWizardState state = ResumeWizardState.CreateBlank();
    private readonly CancellationTokenSource lifetimeCts = new();
    private IReadOnlyList<string> errors = [];
    private string statusMessage = string.Empty;
    private string sourceMarkdown = string.Empty;
    private PendingResumeUpload? pendingUpload;
    private ResumeStateDto? resumeState;
    private ResumeOperationLeaseDto? operation;
    private ResumeImportJobDto? importJob;
    private CancellationTokenSource? importCts;
    private bool isBusy;
    private bool isSaving;

    private bool ShowImportDialog => importJob is not null
        && importJob.Status is not ResumeImportJobStatuses.Completed and not ResumeImportJobStatuses.Canceled;

    protected override async Task OnInitializedAsync()
    {
        SessionState.Changed += OnSessionChanged;
        if (SessionState.IsAuthenticated)
        {
            resumeState = await ResumeApiClient.GetResumeStateAsync();
        }
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (SessionState.IsAuthenticated)
            {
                resumeState = await ResumeApiClient.GetResumeStateAsync();
            }

            StateHasChanged();
        });
    }

    private async Task SelectFileAsync(InputFileChangeEventArgs args)
    {
        errors = [];
        var file = args.File;
        if (file.Size <= 0 || file.Size > MaxUploadBytes)
        {
            errors = ["Choose a resume file between 1 byte and 10 MB."];
            pendingUpload = null;
            return;
        }

        await using var stream = file.OpenReadStream(MaxUploadBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        pendingUpload = new PendingResumeUpload(
            file.Name,
            string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
            file.Size,
            memory.ToArray());
        statusMessage = "File selected. Continue when you are ready to import it.";
        state.MarkDirty();
    }

    private async Task EnsureOperationAsync()
    {
        if (operation is not null)
        {
            return;
        }

        resumeState = await ResumeApiClient.GetResumeStateAsync();
        operation = await ResumeApiClient.AcquireOperationAsync(
            new AcquireResumeOperationRequest("create", resumeState.Token));
        _ = MaintainHeartbeatAsync(lifetimeCts.Token);
    }

    private async Task<bool> RunImportAsync()
    {
        if (pendingUpload is null || operation is null)
        {
            return false;
        }

        isBusy = true;
        errors = [];
        importCts?.Cancel();
        importCts?.Dispose();
        importCts = CancellationTokenSource.CreateLinkedTokenSource(lifetimeCts.Token);
        try
        {
            importJob = await ResumeApiClient.StartWizardImportAsync(
                pendingUpload,
                operation.OperationId,
                operation.ResumeStateToken,
                state.Language,
                state.Title,
                importCts.Token);
            while (importJob.Status is ResumeImportJobStatuses.Queued or ResumeImportJobStatuses.Running)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(500), importCts.Token);
                importJob = await ResumeApiClient.GetImportJobAsync(importJob.JobId, importCts.Token);
                StateHasChanged();
            }

            if (importJob.Status != ResumeImportJobStatuses.Completed || importJob.WizardResult is null)
            {
                await ReleaseOperationAsync();
                return false;
            }

            state.Apply(importJob.WizardResult);
            state.CreationMethod = "import";
            sourceMarkdown = importJob.SourceMarkdown ?? string.Empty;
            statusMessage = "Import complete. Review each section before saving.";
            importJob = null;
            return true;
        }
        catch (OperationCanceledException) when (importCts.IsCancellationRequested)
        {
            return false;
        }
        catch (Exception exception)
        {
            errors = [exception.Message];
            return false;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RetryImportAsync()
    {
        importJob = null;
        await EnsureOperationAsync();
        await RunImportAsync();
    }

    private void ChooseAnotherFile()
    {
        importJob = null;
        pendingUpload = null;
        statusMessage = "Choose another resume file, then select Continue.";
    }

    private async Task CancelImportAsync()
    {
        importCts?.Cancel();
        try
        {
            if (importJob is not null && operation is not null)
            {
                await ResumeApiClient.CancelImportJobAsync(importJob.JobId, operation.OperationId);
                operation = null;
            }
            else
            {
                await ReleaseOperationAsync();
            }
        }
        catch
        {
            operation = null;
        }

        importJob = null;
        isBusy = false;
        statusMessage = "Import canceled. You can choose a file and start again.";
    }

    private async Task MaintainHeartbeatAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested && operation is not null)
            {
                await Task.Delay(TimeSpan.FromSeconds(30), cancellationToken);
                if (operation is not null)
                {
                    operation = await ResumeApiClient.HeartbeatOperationAsync(operation.OperationId, cancellationToken);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                errors = [exception.Message];
                operation = null;
            });
        }
    }

    private async Task ContinueAsync()
    {
        var validationErrors = state.ValidateCurrentStep().ToList();
        if (state.CurrentStep == ResumeWizardStep.Start
            && state.CreationMethod == "import"
            && pendingUpload is null)
        {
            validationErrors.Add("Choose a resume file before continuing.");
        }

        errors = validationErrors;
        if (errors.Count > 0)
        {
            return;
        }

        if (state.CurrentStep == ResumeWizardStep.Start)
        {
            try
            {
                await EnsureOperationAsync();
                if (state.CreationMethod == "import" && !await RunImportAsync())
                {
                    return;
                }
            }
            catch (Exception exception)
            {
                errors = [exception.Message];
                return;
            }
        }

        state.MarkCompleted(state.CurrentStep);
        state.MoveNext();
        statusMessage = string.Empty;
    }

    private void MoveBack()
    {
        errors = [];
        statusMessage = string.Empty;
        state.MoveBack();
    }

    private void NavigateToStep(ResumeWizardStep step)
    {
        errors = [];
        statusMessage = string.Empty;
        state.NavigateTo(step);
    }

    private async Task SaveAsync()
    {
        if (operation is null)
        {
            errors = ["The resume session expired. Return to the first step and start again."];
            return;
        }

        isSaving = true;
        errors = [];
        try
        {
            var dto = state.ToDto();
            var markdown = ResumeWizardMarkdownBuilder.Build(dto);
            await ResumeApiClient.SaveResumeAsync(new SaveResumeMarkdownRequest(
                dto.Title,
                markdown,
                dto.Language,
                pendingUpload?.FileName,
                pendingUpload?.ContentType,
                pendingUpload?.Size,
                pendingUpload is null ? null : Convert.ToBase64String(pendingUpload.Content),
                operation.OperationId,
                operation.ResumeStateToken));
            await ReleaseOperationAsync();
            state.MarkSaved();
            Navigation.NavigateTo("/resume/workspace");
        }
        catch (Exception ex)
        {
            errors = [ex.Message];
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (state.IsDirty && !await JS.InvokeAsync<bool>("confirm", "Leave resume creation? Unsaved information will be lost."))
        {
            return;
        }

        await ReleaseOperationAsync();
        state.MarkSaved();
        Navigation.NavigateTo("/resume");
    }

    private async Task ReleaseOperationAsync()
    {
        var active = operation;
        operation = null;
        if (active is not null)
        {
            await ResumeApiClient.ReleaseOperationAsync(active.OperationId);
        }
    }

    private async Task ConfirmInternalNavigation(LocationChangingContext context)
    {
        if (isBusy)
        {
            context.PreventNavigation();
            return;
        }

        if (!state.IsDirty || isSaving)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Leave resume creation? Unsaved information will be lost.");
        if (!confirmed)
        {
            context.PreventNavigation();
        }
    }

    public void Dispose()
    {
        SessionState.Changed -= OnSessionChanged;
        importCts?.Cancel();
        importCts?.Dispose();
        lifetimeCts.Cancel();
        lifetimeCts.Dispose();
    }
}
