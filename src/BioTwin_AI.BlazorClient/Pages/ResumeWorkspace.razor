@page "/resume/workspace"
@implements IDisposable
@inject IResumeApiClient ResumeApiClient
@inject SessionState SessionState

<PageTitle>Resume Workspace</PageTitle>

<ProtectedArea Title="Resume workspace requires sign in" Description="Resume import, merge and indexing are available only for signed-in users.">
    <NavigationLock ConfirmExternalNavigation="@isImporting"
                    OnBeforeInternalNavigation="PreventNavigationDuringImport" />
    <BlockingProgressOverlay Visible="@ShowImportDialog"
                             Job="@importJob"
                             OnCancel="CancelImportAsync"
                             OnRetry="RetryImportAsync"
                             OnChooseAnother="ChooseAnotherFiles" />
    <section class="resume-workspace">
        <aside class="workspace-library mac-window">
            <div class="window-controls" aria-hidden="true">
                <span class="dot-red"></span>
                <span class="dot-yellow"></span>
                <span class="dot-green"></span>
            </div>
            <div class="workspace-panel-heading">
                <p class="eyebrow">Library</p>
                <h1>Resume Workspace</h1>
            </div>

            <label class="import-dropzone">
                <InputFile OnChange="SelectFilesAsync" multiple disabled="@isImporting" />
                <span>Choose files</span>
                <small>Markdown, text, PDF or Office documents</small>
            </label>

            @if (pendingUploads.Count > 0)
            {
                <div class="pending-upload-list">
                    @foreach (var upload in pendingUploads)
                    {
                        <div class="pending-upload-item">
                            <span>@upload.FileName</span>
                            <button type="button" class="icon-command" title="Remove file" @onclick="() => RemovePending(upload)" disabled="@isImporting">&times;</button>
                        </div>
                    }
                    <button type="button" class="command-button" @onclick="StartWorkspaceImportAsync" disabled="@isImporting">Import</button>
                </div>
            }

            <div class="language-slots">
                @foreach (var language in SupportedLanguages)
                {
                    var summary = GetSummary(language.Code);
                    <button class="language-slot @(selectedKind == WorkspaceItemKind.Canonical && currentLanguage == language.Code ? "active" : "")"
                            @onclick="() => SelectCanonicalAsync(language.Code)"
                            disabled="@(summary is null || isImporting)">
                        <span>@language.Label</span>
                        @if (summary is null)
                        {
                            <small>Empty</small>
                        }
                        else
                        {
                            <strong>@summary.Title</strong>
                            <small>@summary.SectionCount sections</small>
                        }
                    </button>
                }
            </div>

            @if (drafts.Count > 0)
            {
                <div class="draft-list">
                    <p class="eyebrow">Drafts</p>
                    @foreach (var draft in drafts)
                    {
                        <button class="draft-item @(selectedDraftId == draft.Id ? "active" : "")" @onclick="() => SelectDraft(draft)" disabled="@isImporting">
                            <span>@draft.Title</span>
                            <small>@LanguageLabel(draft.Language) · @(draft.IsMergePreview ? "merge preview" : "import")</small>
                        </button>
                    }
                </div>
            }
        </aside>

        <main class="workspace-editor mac-window">
            <div class="editor-command-strip">
                <div>
                    <p class="eyebrow">Canonical Markdown</p>
                    <h2>@(string.IsNullOrWhiteSpace(title) ? "Untitled resume" : title)</h2>
                </div>
                <div class="editor-actions">
                    <button class="command-button secondary" @onclick="MergePreviewAsync" disabled="@(!CanMergePreview)">Merge preview</button>
                    <button class="command-button" @onclick="SaveAsync" disabled="@(!CanSave)">Save</button>
                </div>
            </div>

            <div class="editor-form-grid">
                <label>
                    <span>Title</span>
                    <input @bind="title" @bind:event="oninput" disabled="@isImporting" />
                </label>
                <label>
                    <span>Language</span>
                    <select @bind="currentLanguage" disabled="@isImporting">
                        @foreach (var language in SupportedLanguages)
                        {
                            <option value="@language.Code">@language.Label</option>
                        }
                    </select>
                </label>
            </div>

            <MarkdownEditor @bind-Value="markdown" CssClass="workspace-markdown-editor" Placeholder="Import a resume or start writing Markdown..." />

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="status-line">@message</p>
            }
        </main>

        <aside class="workspace-outline mac-window">
            <div class="workspace-panel-heading">
                <p class="eyebrow">Outline</p>
                <h2>Markdown Tree</h2>
            </div>
            @{
                var outline = BuildOutline(markdown);
            }
            @if (outline.Count == 0)
            {
                <p class="outline-empty">Headings will appear here as you edit.</p>
            }
            else
            {
                <ol class="outline-tree">
                    @foreach (var node in outline)
                    {
                        <OutlineNode Node="node" />
                    }
                </ol>
            }
        </aside>
    </section>
</ProtectedArea>

@code {
    private const long MaxUploadBytes = 10 * 1024 * 1024;
    private static readonly LanguageOption[] SupportedLanguages =
    [
        new(ResumeLanguages.SimplifiedChinese, "Simplified Chinese"),
        new(ResumeLanguages.English, "English")
    ];

    private IReadOnlyList<ResumeSummaryDto> summaries = [];
    private readonly List<WorkspaceDraft> drafts = [];
    private readonly List<PendingResumeUpload> pendingUploads = [];
    private readonly CancellationTokenSource lifetimeCts = new();
    private string title = string.Empty;
    private string markdown = string.Empty;
    private string currentLanguage = ResumeLanguages.SimplifiedChinese;
    private string message = string.Empty;
    private int? selectedCanonicalId;
    private int? selectedDraftId;
    private WorkspaceItemKind selectedKind = WorkspaceItemKind.None;
    private int nextDraftId = 1;
    private bool isImporting;
    private ResumeStateDto? resumeState;
    private ResumeOperationLeaseDto? operation;
    private ResumeImportJobDto? importJob;
    private CancellationTokenSource? importCts;

    private bool ShowImportDialog => importJob is not null
        && importJob.Status is not ResumeImportJobStatuses.Completed and not ResumeImportJobStatuses.Canceled;

    private bool CanSave => SessionState.IsAuthenticated && !isImporting && !string.IsNullOrWhiteSpace(markdown) && ResumeLanguages.IsSupported(currentLanguage);

    private bool CanMergePreview =>
        CanSave
        && selectedKind == WorkspaceItemKind.Draft
        && GetSummary(currentLanguage) is not null;

    protected override async Task OnInitializedAsync()
    {
        await SessionState.RefreshAsync();
        if (!SessionState.IsAuthenticated)
        {
            return;
        }

        await RefreshSummariesAsync();
        var first = summaries.FirstOrDefault();
        if (first is not null)
        {
            await SelectCanonicalAsync(first.Language);
        }
    }

    private async Task RefreshSummariesAsync()
    {
        resumeState = await ResumeApiClient.GetResumeStateAsync();
        summaries = resumeState.Resumes;
    }

    private ResumeSummaryDto? GetSummary(string language)
    {
        return summaries.FirstOrDefault(summary => string.Equals(summary.Language, language, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SelectCanonicalAsync(string language)
    {
        var summary = GetSummary(language);
        if (summary is null)
        {
            return;
        }

        try
        {
            var detail = await ResumeApiClient.GetResumeAsync(summary.Id);
            var export = await ResumeApiClient.ExportMarkdownAsync(summary.Id);
            title = detail.Title;
            currentLanguage = detail.Language;
            markdown = export.Markdown;
            selectedCanonicalId = detail.Id;
            selectedDraftId = null;
            selectedKind = WorkspaceItemKind.Canonical;
            message = string.Empty;
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private async Task SelectFilesAsync(InputFileChangeEventArgs args)
    {
        message = string.Empty;
        foreach (var file in args.GetMultipleFiles())
        {
            if (file.Size <= 0 || file.Size > MaxUploadBytes)
            {
                message = $"{file.Name} must be between 1 byte and 10 MB.";
                continue;
            }

            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            pendingUploads.RemoveAll(item => string.Equals(item.FileName, file.Name, StringComparison.OrdinalIgnoreCase));
            pendingUploads.Add(new PendingResumeUpload(
                file.Name,
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                file.Size,
                memory.ToArray()));
        }

        if (pendingUploads.Count > 0)
        {
            message = "Files selected. Review the list, then choose Import.";
        }
    }

    private void RemovePending(PendingResumeUpload upload) => pendingUploads.Remove(upload);

    private async Task StartWorkspaceImportAsync()
    {
        if (pendingUploads.Count == 0 || isImporting)
        {
            return;
        }

        try
        {
            await EnsureOperationAsync();
            await RunWorkspaceImportAsync();
        }
        catch (Exception exception)
        {
            message = exception.Message;
        }
    }

    private async Task EnsureOperationAsync()
    {
        if (operation is not null)
        {
            return;
        }

        await RefreshSummariesAsync();
        operation = await ResumeApiClient.AcquireOperationAsync(
            new AcquireResumeOperationRequest("import", resumeState!.Token));
        _ = MaintainHeartbeatAsync(lifetimeCts.Token);
    }

    private async Task RunWorkspaceImportAsync()
    {
        if (operation is null || pendingUploads.Count == 0)
        {
            return;
        }

        isImporting = true;
        importCts?.Cancel();
        importCts?.Dispose();
        importCts = CancellationTokenSource.CreateLinkedTokenSource(lifetimeCts.Token);
        try
        {
            importJob = await ResumeApiClient.StartWorkspaceImportAsync(
                pendingUploads,
                operation.OperationId,
                operation.ResumeStateToken,
                importCts.Token);
            while (importJob.Status is ResumeImportJobStatuses.Queued or ResumeImportJobStatuses.Running)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(500), importCts.Token);
                importJob = await ResumeApiClient.GetImportJobAsync(importJob.JobId, importCts.Token);
                StateHasChanged();
            }

            if (importJob.Status != ResumeImportJobStatuses.Completed || importJob.WorkspaceResults is null)
            {
                await ReleaseOperationAsync();
                return;
            }

            foreach (var converted in importJob.WorkspaceResults)
            {
                var upload = pendingUploads.FirstOrDefault(item =>
                    string.Equals(item.FileName, converted.SourceFileName, StringComparison.OrdinalIgnoreCase));
                var draft = new WorkspaceDraft(
                    nextDraftId++,
                    converted.Title,
                    converted.Markdown,
                    ResumeLanguages.Normalize(converted.DetectedLanguage),
                    upload?.FileName ?? converted.SourceFileName,
                    upload?.ContentType,
                    upload?.Size,
                    upload is null ? null : Convert.ToBase64String(upload.Content),
                    IsMergePreview: false);
                drafts.Insert(0, draft);
                SelectDraft(draft);
            }

            pendingUploads.Clear();
            importJob = null;
            message = "Imported drafts are ready for review. Nothing is saved until you choose Save.";
        }
        catch (OperationCanceledException) when (importCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            message = exception.Message;
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task RetryImportAsync()
    {
        importJob = null;
        await EnsureOperationAsync();
        await RunWorkspaceImportAsync();
    }

    private void ChooseAnotherFiles()
    {
        importJob = null;
        pendingUploads.Clear();
        message = "Choose the resume files you want to import.";
    }

    private async Task CancelImportAsync()
    {
        importCts?.Cancel();
        try
        {
            if (importJob is not null && operation is not null)
            {
                await ResumeApiClient.CancelImportJobAsync(importJob.JobId, operation.OperationId);
                operation = null;
            }
            else
            {
                await ReleaseOperationAsync();
            }
        }
        catch
        {
            operation = null;
        }

        importJob = null;
        isImporting = false;
        message = "Import canceled. Your selected files were not saved.";
    }

    private async Task MaintainHeartbeatAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested && operation is not null)
            {
                await Task.Delay(TimeSpan.FromSeconds(30), cancellationToken);
                if (operation is not null)
                {
                    operation = await ResumeApiClient.HeartbeatOperationAsync(operation.OperationId, cancellationToken);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                operation = null;
                message = exception.Message;
            });
        }
    }

    private Task PreventNavigationDuringImport(LocationChangingContext context)
    {
        if (isImporting)
        {
            context.PreventNavigation();
        }

        return Task.CompletedTask;
    }

    private void SelectDraft(WorkspaceDraft draft)
    {
        selectedDraftId = draft.Id;
        selectedCanonicalId = null;
        selectedKind = WorkspaceItemKind.Draft;
        title = draft.Title;
        markdown = draft.Markdown;
        currentLanguage = draft.Language;
        message = draft.IsMergePreview ? "Review the merge preview, then save to update the canonical resume." : string.Empty;
    }

    private async Task MergePreviewAsync()
    {
        if (!CanMergePreview)
        {
            return;
        }

        try
        {
            var preview = await ResumeApiClient.MergePreviewAsync(new MergeResumeMarkdownRequest(
                currentLanguage,
                title,
                markdown,
                drafts.FirstOrDefault(draft => draft.Id == selectedDraftId)?.SourceFileName));
            var draft = new WorkspaceDraft(
                nextDraftId++,
                preview.MergedTitle,
                preview.MergedMarkdown,
                preview.Language,
                drafts.FirstOrDefault(item => item.Id == selectedDraftId)?.SourceFileName,
                null,
                null,
                null,
                IsMergePreview: true);
            drafts.Insert(0, draft);
            SelectDraft(draft);
            message = preview.Warnings.Count == 0 ? "Merge preview generated." : string.Join(" ", preview.Warnings);
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        try
        {
            await EnsureOperationAsync();
            if (operation is null)
            {
                return;
            }

            var draft = drafts.FirstOrDefault(item => item.Id == selectedDraftId);
            var detail = await ResumeApiClient.SaveResumeAsync(new SaveResumeMarkdownRequest(
                title,
                markdown,
                currentLanguage,
                draft?.SourceFileName,
                draft?.SourceContentType,
                draft?.SourceFileSize,
                draft?.SourceFileContentBase64,
                operation.OperationId,
                operation.ResumeStateToken));
            await ReleaseOperationAsync();
            await RefreshSummariesAsync();
            selectedCanonicalId = detail.Id;
            selectedDraftId = null;
            selectedKind = WorkspaceItemKind.Canonical;
            title = detail.Title;
            currentLanguage = detail.Language;
            message = "Saved, split into sections and re-indexed.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private async Task ReleaseOperationAsync()
    {
        var active = operation;
        operation = null;
        if (active is not null)
        {
            await ResumeApiClient.ReleaseOperationAsync(active.OperationId);
        }
    }

    private static string LanguageLabel(string language)
    {
        return string.Equals(language, ResumeLanguages.English, StringComparison.OrdinalIgnoreCase)
            ? "English"
            : "Simplified Chinese";
    }

    private static IReadOnlyList<OutlineTreeItem> BuildOutline(string value)
    {
        var roots = new List<OutlineTreeItem>();
        var stack = new Stack<OutlineTreeItem>();
        var inFence = false;

        foreach (var rawLine in value.Split('\n'))
        {
            var line = rawLine.TrimEnd('\r');
            if (line.TrimStart().StartsWith("```", StringComparison.Ordinal))
            {
                inFence = !inFence;
                continue;
            }

            if (inFence || !line.StartsWith('#'))
            {
                continue;
            }

            var level = line.TakeWhile(ch => ch == '#').Count();
            if (level is < 1 or > 6 || line.Length <= level || line[level] != ' ')
            {
                continue;
            }

            var text = line[(level + 1)..].Trim();
            if (string.IsNullOrWhiteSpace(text))
            {
                continue;
            }

            var node = new OutlineTreeItem(level, text);
            while (stack.Count > 0 && stack.Peek().Level >= level)
            {
                stack.Pop();
            }

            if (stack.Count == 0)
            {
                roots.Add(node);
            }
            else
            {
                stack.Peek().Children.Add(node);
            }

            stack.Push(node);
        }

        return roots;
    }

    private sealed record LanguageOption(string Code, string Label);

    private sealed record WorkspaceDraft(
        int Id,
        string Title,
        string Markdown,
        string Language,
        string? SourceFileName,
        string? SourceContentType,
        long? SourceFileSize,
        string? SourceFileContentBase64,
        bool IsMergePreview);

    private enum WorkspaceItemKind
    {
        None,
        Canonical,
        Draft
    }

    public void Dispose()
    {
        importCts?.Cancel();
        importCts?.Dispose();
        lifetimeCts.Cancel();
        lifetimeCts.Dispose();
    }

}
