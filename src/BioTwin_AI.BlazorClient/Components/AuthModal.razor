@implements IDisposable
@inject AuthModalState AuthModalState
@inject IAuthApiClient AuthApiClient
@inject SessionState SessionState

@if (AuthModalState.IsOpen)
{
    <div class="modal-scrim" @onclick="Close">
        <section class="auth-modal mica-panel auth-card auth-window mac-window" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title" tabindex="-1" @onclick:stopPropagation>
            <div class="window-controls auth-window-controls" aria-hidden="true">
                <span class="system-dot dot-red"></span>
                <span class="system-dot dot-yellow"></span>
                <span class="system-dot dot-green"></span>
                <span class="terminal-caption">identity</span>
            </div>
            <button class="modal-close" title="Close" aria-label="Close sign in dialog" @onclick="Close">x</button>
            <div class="auth-modal-header">
                <p class="eyebrow">Identity Gateway</p>
                <h2 id="auth-modal-title">@(AuthModalState.IsRegisterMode ? "Create local account" : "Sign in")</h2>
                <p class="muted-copy">Local account today, ready for GitHub, Google, Microsoft, Cloudflare Access, and Turnstile later.</p>
            </div>

            <div class="auth-fields">
                <label class="auth-field">
                    <span>Username</span>
                    <input class="auth-input" autocomplete="username" placeholder="username" @bind="username" />
                </label>
                @if (AuthModalState.IsRegisterMode)
                {
                    <label class="auth-field">
                        <span>Nickname</span>
                        <input class="auth-input" autocomplete="nickname" placeholder="nickname" @bind="nickname" />
                    </label>
                    <div class="auth-field auth-avatar-field">
                        <span>Avatar:</span>
                        <div class="avatar-options compact-avatar-options" role="listbox" aria-label="Choose avatar">
                            @foreach (var avatar in avatarOptions)
                            {
                                <button
                                    type="button"
                                    class="avatar-choice @(selectedAvatar == avatar ? "selected" : null)"
                                    aria-label="@($"Use avatar {avatar}")"
                                    aria-selected="@(selectedAvatar == avatar)"
                                    @onclick="() => selectedAvatar = avatar">
                                    @avatar
                                </button>
                            }
                        </div>
                    </div>
                }
                <label class="auth-field">
                    <span>Password</span>
                    <input class="auth-input" type="password" autocomplete="current-password" placeholder="password" @bind="password" />
                </label>
            </div>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="error-line">@error</p>
            }

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="status-line">@message</p>
            }

            <div class="action-row auth-action-row">
                <button class="command-button auth-button auth-button-primary" @onclick="SubmitAsync" disabled="@isBusy">
                    @(isBusy ? "Working..." : AuthModalState.IsRegisterMode ? "Register" : "Login")
                </button>
                <button class="command-button secondary auth-button" @onclick="InterviewerLoginAsync" disabled="@isBusy">Interviewer</button>
            </div>
            <button class="link-command auth-mode-link" @onclick="SwitchMode">
                @(AuthModalState.IsRegisterMode ? "I already have an account" : "Create a local account")
            </button>
        </section>
    </div>
}

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string nickname = string.Empty;
    private string selectedAvatar = "🧑‍💻";
    private string message = string.Empty;
    private string error = string.Empty;
    private bool isBusy;
    private readonly string[] avatarOptions =
    [
        "🧑‍💻", "👩‍💻", "👨‍💻", "🧑‍🔬", "👩‍🔬", "👨‍🔬", "🧑‍🚀", "👩‍🚀",
        "👨‍🚀", "🧑‍🎨", "👩‍🎨", "👨‍🎨", "🧑‍🏫", "👩‍🏫", "👨‍🏫", "🕵️"
    ];

    protected override void OnInitialized()
    {
        AuthModalState.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        AuthModalState.Changed -= StateHasChanged;
    }

    private async Task SubmitAsync()
    {
        error = string.Empty;
        message = string.Empty;
        isBusy = true;

        try
        {
            var result = AuthModalState.IsRegisterMode
                ? await AuthApiClient.RegisterAsync(new RegisterRequest(
                    username,
                    password,
                    Nickname: nickname,
                    Avatar: selectedAvatar))
                : await AuthApiClient.LoginAsync(new LoginRequest(username, password));

            if (result.Success)
            {
                message = result.Message;
                await SessionState.RefreshAsync();
                AuthModalState.Close();
                return;
            }

            error = result.Message;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task InterviewerLoginAsync()
    {
        error = string.Empty;
        message = string.Empty;
        isBusy = true;

        try
        {
            var result = await AuthApiClient.InterviewerLoginAsync();
            if (result.Success)
            {
                message = result.Message;
                await SessionState.RefreshAsync();
                AuthModalState.Close();
                return;
            }

            error = result.Message;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SwitchMode()
    {
        if (AuthModalState.IsRegisterMode)
        {
            AuthModalState.UseSignIn();
        }
        else
        {
            AuthModalState.UseRegister();
        }
    }

    private void Close()
    {
        error = string.Empty;
        message = string.Empty;
        AuthModalState.Close();
    }
}
