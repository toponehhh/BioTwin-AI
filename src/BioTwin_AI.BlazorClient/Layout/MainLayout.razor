@inherits LayoutComponentBase
@implements IDisposable
@inject BioTwin_AI.BlazorClient.Services.ThemeState ThemeState
@inject BioTwin_AI.BlazorClient.Services.AuthModalState AuthModalState
@inject BioTwin_AI.BlazorClient.Services.SessionState SessionState
@inject NavigationManager Navigation

<FluentDesignTheme Mode="@FluentThemeMode" StorageName="biotwin.fluent.theme" />
<FluentToastProvider />
<AuthModal />
@if (isProfileEditorOpen)
{
    <div class="modal-scrim" @onclick="CloseProfileEditor">
        <section class="auth-modal mica-panel profile-editor-modal" role="dialog" aria-modal="true" aria-labelledby="profile-editor-title" @onclick:stopPropagation>
            <button class="modal-close" title="Close" aria-label="Close profile editor" @onclick="CloseProfileEditor">x</button>
            <p class="eyebrow">Profile</p>
            <h2 id="profile-editor-title">Edit profile</h2>
            <p class="muted-copy">Update the nickname and avatar shown in your BioTwin AI workspace.</p>

            <label>Nickname</label>
            <input autocomplete="nickname" @bind="editNickname" />
            <label>Avatar</label>
            <div class="avatar-options" role="listbox" aria-label="Choose profile avatar">
                @foreach (var avatar in avatarOptions)
                {
                    <button
                        type="button"
                        class="avatar-choice @(editAvatar == avatar ? "selected" : null)"
                        aria-label="@($"Use avatar {avatar}")"
                        aria-selected="@(editAvatar == avatar)"
                        @onclick="() => editAvatar = avatar">
                        @avatar
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(profileError))
            {
                <p class="error-line">@profileError</p>
            }
            @if (!string.IsNullOrWhiteSpace(profileMessage))
            {
                <p class="status-line">@profileMessage</p>
            }

            <div class="action-row">
                <button class="command-button" @onclick="SaveProfileAsync" disabled="@isSavingProfile">
                    @(isSavingProfile ? "Saving..." : "Save profile")
                </button>
                <button class="command-button secondary" @onclick="CloseProfileEditor" disabled="@isSavingProfile">Cancel</button>
            </div>
        </section>
    </div>
}

<div class="page app-shell theme-@ThemeState.CurrentTheme.ToString().ToLowerInvariant()">
    @if (isAdminMenuOpen || isMobileMenuOpen)
    {
        <button type="button" class="admin-menu-backdrop" aria-label="Close navigation menu" @onclick="CloseNavigationMenus"></button>
    }

    <header class="site-header">
        <div class="site-header-inner">
            <a class="site-brand" href="/" aria-label="BioTwin AI home" @onclick="CloseNavigationMenus">
                <span>BioTwin</span><strong>AI</strong>
            </a>

            <nav class="site-nav @(isMobileMenuOpen ? "open" : null)" aria-label="Primary navigation">
                <NavLink class="site-nav-link nav-home" href="" Match="NavLinkMatch.All" @onclick="CloseNavigationMenus">Home</NavLink>
                <NavLink class="site-nav-link nav-projects" href="projects" @onclick="CloseNavigationMenus">Projects</NavLink>
                <NavLink class="site-nav-link nav-skills" href="skills" @onclick="CloseNavigationMenus">Skills</NavLink>
                <div class="mobile-account-nav">
                    @if (SessionState.IsAuthenticated)
                    {
                        <span class="mobile-session-label">@SessionState.DisplayName</span>
                        <a href="/chat" @onclick="CloseNavigationMenus">Chat</a>
                        <a href="/resume/create" @onclick="CloseNavigationMenus">Create Resume</a>
                        <a href="/resume/workspace" @onclick="CloseNavigationMenus">Resume Workspace</a>
                        <a href="/resume" @onclick="CloseNavigationMenus">Resume Library</a>
                        <a href="/settings" @onclick="CloseNavigationMenus">Settings</a>
                        <button @onclick="OpenProfileEditor">Profile</button>
                        <button class="danger" @onclick="LogoutAsync">Logout</button>
                    }
                    else
                    {
                        <button @onclick="OpenSignIn">Sign in</button>
                    }
                </div>
            </nav>

            <div class="site-header-actions">
                @if (SessionState.IsAuthenticated)
                {
                    <div class="admin-shell desktop-account" @onclick:stopPropagation>
                        <button class="admin-menu-trigger @(isAdminMenuOpen ? "active" : null)" title="Admin menu" aria-label="Open admin menu" aria-expanded="@isAdminMenuOpen" @onclick="ToggleAdminMenu">
                            <span>Admin</span>
                            <span class="admin-avatar">@SessionState.Avatar</span>
                        </button>
                        @if (isAdminMenuOpen)
                        {
                            <div class="admin-menu profile-menu" role="menu">
                                <span class="session-pill">Welcome @SessionState.DisplayName</span>
                                <a class="profile-menu-item" role="menuitem" href="/chat" @onclick="CloseAdminMenu">Chat</a>
                                <a class="profile-menu-item" role="menuitem" href="/resume/create" @onclick="CloseAdminMenu">Create Resume</a>
                                <a class="profile-menu-item" role="menuitem" href="/resume/workspace" @onclick="CloseAdminMenu">Resume Workspace</a>
                                <a class="profile-menu-item" role="menuitem" href="/resume" @onclick="CloseAdminMenu">Resume Library</a>
                                <a class="profile-menu-item" role="menuitem" href="/resume/edit" @onclick="CloseAdminMenu">Edit</a>
                                <a class="profile-menu-item" role="menuitem" href="/resume/export" @onclick="CloseAdminMenu">Export</a>
                                <a class="profile-menu-item" role="menuitem" href="/settings" @onclick="CloseAdminMenu">Settings</a>
                                <button class="profile-menu-item" role="menuitem" @onclick="OpenProfileEditor">Profile</button>
                                <button class="profile-menu-item danger" role="menuitem" @onclick="LogoutAsync">Logout</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <button class="header-sign-in desktop-account" @onclick="OpenSignIn">Sign in</button>
                }
                <button class="mobile-menu-toggle" aria-label="Toggle navigation" aria-expanded="@isMobileMenuOpen" @onclick="ToggleMobileMenu">
                    <span aria-hidden="true">☰</span>
                </button>
                <button class="@ThemeToggleClass" title="@ThemeToggleLabel" aria-label="@ThemeToggleLabel" @onclick="ToggleTheme">
                    <span class="lamp-head" aria-hidden="true">
                        <span class="lamp-shade"></span>
                        <span class="lamp-bulb"></span>
                        <span class="lamp-glow"></span>
                    </span>
                    <span class="lamp-cord" aria-hidden="true"></span>
                    <span class="lamp-pull" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </header>

    <main class="app-main">
        <article class="content page-content @ContentContainerClass">
            @Body
        </article>
    </main>
</div>

@code {
    private DesignThemeModes FluentThemeMode => ThemeState.CurrentTheme == BioTwin_AI.BlazorClient.Services.AppTheme.Dark
        ? DesignThemeModes.Dark
        : DesignThemeModes.Light;
    private string ThemeToggleClass => ThemeState.CurrentTheme == BioTwin_AI.BlazorClient.Services.AppTheme.Light
        ? "lamp-theme-toggle lamp-on"
        : "lamp-theme-toggle lamp-off";
    private string ThemeToggleLabel => ThemeState.CurrentTheme == BioTwin_AI.BlazorClient.Services.AppTheme.Dark
        ? "Turn on light theme"
        : "Turn off light theme";
    private string ContentContainerClass => IsWideWorkspaceRoute()
        ? "site-container site-container-wide"
        : "site-container";
    private bool isAdminMenuOpen;
    private bool isMobileMenuOpen;
    private bool isProfileEditorOpen;
    private bool isSavingProfile;
    private string editNickname = string.Empty;
    private string editAvatar = "🧑‍💻";
    private string profileMessage = string.Empty;
    private string profileError = string.Empty;
    private readonly string[] avatarOptions =
    [
        "🧑‍💻", "👩‍💻", "👨‍💻", "🧑‍🔬", "👩‍🔬", "👨‍🔬", "🧑‍🚀", "👩‍🚀",
        "👨‍🚀", "🧑‍🎨", "👩‍🎨", "👨‍🎨", "🧑‍🏫", "👩‍🏫", "👨‍🏫", "🕵️"
    ];

    protected override async Task OnInitializedAsync()
    {
        ThemeState.Changed += StateHasChanged;
        SessionState.Changed += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await ThemeState.InitializeAsync();
        await SessionState.RefreshAsync();
    }

    public void Dispose()
    {
        ThemeState.Changed -= StateHasChanged;
        SessionState.Changed -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void ToggleTheme()
    {
        ThemeState.SetTheme(ThemeState.CurrentTheme == BioTwin_AI.BlazorClient.Services.AppTheme.Dark
            ? BioTwin_AI.BlazorClient.Services.AppTheme.Light
            : BioTwin_AI.BlazorClient.Services.AppTheme.Dark);
    }

    private async Task LogoutAsync()
    {
        isAdminMenuOpen = false;
        isMobileMenuOpen = false;
        isProfileEditorOpen = false;
        await SessionState.LogoutAsync();
    }

    private void ToggleAdminMenu()
    {
        isMobileMenuOpen = false;
        isAdminMenuOpen = !isAdminMenuOpen;
    }

    private void ToggleMobileMenu()
    {
        isAdminMenuOpen = false;
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseAdminMenu()
    {
        isAdminMenuOpen = false;
    }

    private void CloseNavigationMenus()
    {
        isAdminMenuOpen = false;
        isMobileMenuOpen = false;
    }

    private void OpenSignIn()
    {
        CloseNavigationMenus();
        AuthModalState.OpenSignIn();
    }

    private bool IsWideWorkspaceRoute()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return string.Equals(path, "resume/workspace", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            CloseNavigationMenus();
            StateHasChanged();
        });
    }

    private void OpenProfileEditor()
    {
        editNickname = SessionState.DisplayName;
        editAvatar = SessionState.Avatar;
        profileMessage = string.Empty;
        profileError = string.Empty;
        CloseNavigationMenus();
        isProfileEditorOpen = true;
    }

    private void CloseProfileEditor()
    {
        if (isSavingProfile)
        {
            return;
        }

        isProfileEditorOpen = false;
    }

    private async Task SaveProfileAsync()
    {
        profileMessage = string.Empty;
        profileError = string.Empty;
        isSavingProfile = true;

        try
        {
            var result = await SessionState.UpdateProfileAsync(new UpdateProfileRequest(editNickname, editAvatar));
            if (result.Success)
            {
                profileMessage = result.Message;
                isProfileEditorOpen = false;
                return;
            }

            profileError = result.Message;
        }
        catch (Exception ex)
        {
            profileError = ex.Message;
        }
        finally
        {
            isSavingProfile = false;
        }
    }
}
