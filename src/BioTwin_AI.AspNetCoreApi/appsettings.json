{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/biotwin-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "ConnectionStrings": {
    "BioTwinApi": "Data Source=database/biotwin-api.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5193",
      "https://localhost:7193"
    ]
  },
  "Rag": {
    "EmbeddingSize": 1024
  },
  "CloudflareAI": {
    "AccountId": "",
    "ApiToken": "",
    "ChatModel": "@cf/meta/llama-3.1-8b-instruct-fast",
    "ExtractionModel": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "EmbeddingModel": "@cf/baai/bge-m3",
    "RerankModel": "@cf/baai/bge-reranker-base"
  },
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKey": "",
    "ChatModel": "openrouter/free",
    "ExtractionModel": "openai/gpt-oss-20b:free"
  },
  "Embedding": {
    "PrimaryProvider": "CloudflareWorkersAI",
    "FallbackProvider": "BgeM3Onnx",
    "FallbackEnabled": true,
    "FallbackCooldownSeconds": 60,
    "RequestTimeoutSeconds": 60,
    "ExpectedDimensions": 1024,
    "ModelDirectory": "../../LLM/bge_m3",
    "ModelPath": "bge_m3_model.onnx",
    "TokenizerPath": "bge_m3_tokenizer.onnx",
    "MaxTokens": 8192
  },
  "Rerank": {
    "Enabled": true,
    "PrimaryProvider": "CloudflareWorkersAI",
    "FallbackProvider": "BgeRerankerOnnx",
    "FallbackEnabled": true,
    "FallbackCooldownSeconds": 60,
    "RequestTimeoutSeconds": 60,
    "CandidateCount": 20,
    "ModelDirectory": "../../LLM/bge_rerank_v2",
    "ModelPath": "model.onnx",
    "TokenizerPath": "tokenizer.json",
    "MaxTokens": 8192
  },
  "All2MD": {
    "ApiUrl": "https://all2mdapi.ai-show.cc.cd",
    "TimeoutSeconds": 600
  },
  "LLM": {
    "PrimaryProvider": "CloudflareWorkersAI",
    "FallbackProvider": "OpenRouter",
    "FallbackEnabled": true,
    "FallbackCooldownSeconds": 60,
    "Temperature": 0.2,
    "MaxTokens": 800,
    "MaxContextChars": 6000,
    "MaxSnippetChars": 2000,
    "RequestTimeoutSeconds": 180,
    "ExtractionTimeoutSeconds": 600,
    "ExtractionMaxTokens": 8000,
    "ExtractionProgressIntervalSeconds": 10,
    "RefinementTemperature": 0.1,
    "RefinementMaxTokens": 3000
  },
  "AllowedHosts": "*"
}
